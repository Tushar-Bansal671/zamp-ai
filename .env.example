# Copy to .env.local and fill in (restart the dev server after changing it).

# Required for LLM PDF extraction. Without it, the engine falls back to the
# local heuristic parser (still fully functional on text-based invoices).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The extraction model. Recommended for speed + cost: the 3.5 Haiku tier,
# which is ideal for structured "read this PDF, return this JSON" work.
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Prefer maximum accuracy on messy/scanned invoices instead? Use:
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
